---
/**
 * ============================================================================
 * EVERYTOOL — BEGINNERS GUIDE (/beginners-guide) WITH THEME SWITCHER
 * ============================================================================
 * Features the complete FMHY dual-group sidebar and theme switcher.
 */

import tools from "../data/tools.json";
import "../styles/global.css";

// 1. EXTRACT CATEGORIES BY SECTION
const wikiCategories = [...new Set(tools.filter((t) => t.section === "Wiki").map((t) => t.category))];
const toolCategories = [...new Set(tools.filter((t) => t.section === "Tools").map((t) => t.category))];

function toSlug(cat: string) {
	return cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const categoryIcons: Record<string, string> = {
	// Wiki Sections
	"Adblocking / Privacy": "⛔",
	"Artificial Intelligence": "🤖",
	"Movies / TV / Anime": "📺",
	"Music / Podcasts / Radio": "🎵",
	"Gaming / Emulation": "🎮",
	"Books / Comics / Manga": "📗",
	"Downloading": "💾",
	"Torrenting": "🌀",
	"Educational": "🧠",
	"Android / iOS": "📱",
	"Linux / macOS": "🐧",

	// Tools Sections
	"System Tools": "⚙️",
	"File Tools": "📁",
	"Internet Tools": "🌐",
	"Social Media Tools": "💬",
	"Text Tools": "📝",
	"Gaming Tools": "🕹️",
	"Image Tools": "🎨",
	"Video Tools": "🎬",
	"Developer Tools": "💻",
};
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Beginners Guide — EveryTool</title>

		<script is:inline>
			const savedMode = localStorage.getItem("everytool-mode") || "light";
			const savedAccent = localStorage.getItem("everytool-accent") || "#c2410c";
			if (savedMode === "dark") document.documentElement.classList.add("theme-dark");
			if (savedMode === "amoled") document.documentElement.classList.add("theme-amoled");
			document.documentElement.style.setProperty("--accent-color", savedAccent);
		</script>
	</head>

	<body class="bg-[var(--bg-body)] text-[var(--text-main)] font-sans antialiased selection:bg-[#fed7aa] selection:text-[#7c2d12] transition-colors duration-150">
		<div class="min-h-screen flex">
			
			<!-- ============================================================= -->
			<!-- 1. LEFT SIDEBAR (FMHY WIKI + TOOLS DUAL NAVIGATION)           -->
			<!-- ============================================================= -->
			<aside class="w-68 flex-shrink-0 min-h-screen bg-[var(--bg-sidebar)] border-r border-[var(--border-main)] flex flex-col justify-between sticky top-0 h-screen overflow-y-auto sidebar-scroll transition-colors duration-150">
				<div>
					<!-- Logo -->
					<div class="px-6 py-4 flex items-center gap-2.5 border-b border-[var(--border-main)]">
						<svg class="w-3.5 h-3.5 text-accent fill-current" viewBox="0 0 24 24">
							<polygon points="5 3 19 12 5 21 5 3"/>
						</svg>
						<a href="/" class="font-bold text-[var(--text-main)] tracking-tight text-base hover:opacity-80 transition">
							EveryTool
						</a>
					</div>

					<!-- Primary Quick Links -->
					<div class="px-3.5 py-3 border-b border-[var(--border-main)] text-[13.5px] font-medium space-y-0.5">
						<a href="/beginners-guide" class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-accent bg-[var(--bg-hover)] font-semibold transition">
							<span class="text-sm">📚</span>
							<span>Beginners Guide</span>
						</a>
						<a href="/#movies-tv-anime" class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-hover)] transition">
							<span class="text-sm">📰</span>
							<span>Posts</span>
						</a>
						<a href="https://github.com" target="_blank" rel="noopener" class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-hover)] transition">
							<span class="text-sm">💡</span>
							<span>Contribute</span>
						</a>
					</div>

					<!-- SECTION 1: WIKI -->
					<div class="px-3.5 pt-4 pb-2">
						<div class="flex items-center justify-between px-3 mb-1.5 font-bold text-[var(--text-main)] text-[13px]">
							<span>Wiki</span>
							<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<polyline points="6 9 12 15 18 9"/>
							</svg>
						</div>

						<ul class="space-y-0.5">
							{
								wikiCategories.map((cat) => (
									<li>
										<a
											href={`/#${toSlug(cat)}`}
											class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:text-accent hover:bg-[var(--bg-hover)] transition font-medium text-[13px]"
										>
											<span class="text-xs">{categoryIcons[cat] || "📁"}</span>
											<span>{cat}</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<!-- SECTION 2: TOOLS -->
					<div class="px-3.5 pt-3 pb-5 border-t border-[var(--border-main)]">
						<div class="flex items-center justify-between px-3 mb-1.5 font-bold text-[var(--text-main)] text-[13px]">
							<span>Tools</span>
							<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<polyline points="6 9 12 15 18 9"/>
							</svg>
						</div>

						<ul class="space-y-0.5">
							{
								toolCategories.map((cat) => (
									<li>
										<a
											href={`/#${toSlug(cat)}`}
											class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:text-accent hover:bg-[var(--bg-hover)] transition font-medium text-[13px]"
										>
											<span class="text-xs">{categoryIcons[cat] || "🧰"}</span>
											<span>{cat}</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>

				<div class="p-4 border-t border-[var(--border-main)] text-[12px] font-medium text-[var(--text-muted)]">
					<span>⚡ {tools.length} Curated Tools</span>
				</div>
			</aside>

			<!-- ============================================================= -->
			<!-- 2. MAIN GUIDE CONTENT                                         -->
			<!-- ============================================================= -->
			<div class="flex-1 flex flex-col min-w-0">
				
				<!-- Top Bar -->
				<header class="sticky top-0 z-30 bg-[var(--bg-body)]/95 backdrop-blur border-b border-[var(--border-main)] px-8 py-3 flex items-center justify-between transition-colors duration-150">
					<div class="relative w-88">
						<input
							type="text"
							placeholder="Search directory... (Ctrl K)"
							onkeydown="if(event.key==='Enter'){window.location.href='/?q='+encodeURIComponent(this.value)}"
							class="w-full text-sm bg-[var(--bg-input)] border border-[var(--border-main)] rounded-lg pl-9 pr-14 py-2 focus:outline-none focus:bg-[var(--bg-card)] focus:border-accent text-[var(--text-main)] transition shadow-inner placeholder:text-[var(--text-muted)]"
						/>
						<span class="absolute left-3 top-2.5 text-slate-400 text-sm">🔍</span>
						<kbd class="absolute right-2.5 top-2 px-1.5 py-0.5 text-[10px] font-mono text-[var(--text-muted)] bg-[var(--bg-card)] border border-[var(--border-main)] rounded shadow-xs">
							Ctrl K
						</kbd>
					</div>

					<div class="flex items-center gap-6 text-sm text-[var(--text-muted)] font-medium">
						<a href="/beginners-guide" class="text-accent font-semibold flex items-center gap-1.5">
							<span>🗂️</span> Beginners Guide
						</a>
						<a href="/#system-tools" class="hover:text-[var(--text-main)] flex items-center gap-1.5 transition">
							<span>📋</span> Changelog
						</a>
						<a href="/#developer-tools" class="hover:text-[var(--text-main)] flex items-center gap-1.5 transition">
							<span>🛠️</span> Tools <span class="text-[10px]">▾</span>
						</a>

						<div class="flex items-center gap-3.5 pl-4 border-l border-[var(--border-main)]">
							
							<!-- Theme Palette Trigger & Floating Dropdown -->
							<div class="relative">
								<button
									id="themeMenuBtn"
									type="button"
									class="p-1.5 rounded-lg hover:bg-[var(--bg-hover)] text-base transition cursor-pointer"
									title="Customize Appearance & Theme"
								>
									🎨
								</button>

								<div
									id="themeDropdown"
									class="absolute right-0 top-full mt-2.5 w-64 bg-[var(--bg-card)] border border-[var(--border-main)] rounded-2xl shadow-2xl p-4 hidden z-50 text-xs"
								>
									<div class="absolute -top-1.5 right-3 w-3 h-3 bg-[var(--bg-card)] border-t border-l border-[var(--border-main)] rotate-45"></div>

									<div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">
										Appearance
									</div>

									<div class="space-y-1 mb-4">
										<button type="button" data-mode="light" class="theme-mode-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-left hover:bg-[var(--bg-hover)] transition font-medium cursor-pointer">
											<span class="flex items-center gap-2.5"><span class="text-amber-500 text-sm">☀️</span><span>Light</span></span>
											<span class="mode-check text-accent font-bold text-sm hidden">✓</span>
										</button>
										<button type="button" data-mode="dark" class="theme-mode-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-left hover:bg-[var(--bg-hover)] transition font-medium cursor-pointer">
											<span class="flex items-center gap-2.5"><span class="text-indigo-400 text-sm">🌙</span><span>Dark</span></span>
											<span class="mode-check text-accent font-bold text-sm hidden">✓</span>
										</button>
										<button type="button" data-mode="amoled" class="theme-mode-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-left hover:bg-[var(--bg-hover)] transition font-medium cursor-pointer">
											<span class="flex items-center gap-2.5"><span class="text-slate-300 text-sm">🌚</span><span>AMOLED</span></span>
											<span class="mode-check text-accent font-bold text-sm hidden">✓</span>
										</button>
									</div>

									<div class="pt-3 border-t border-[var(--border-subtle)]">
										<div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2.5">Color Themes</div>
										<div class="flex items-center justify-between px-1">
											<button type="button" data-accent="#3b82f6" class="accent-btn w-5 h-5 rounded-full bg-blue-500 hover:scale-125 transition cursor-pointer" title="Blue"></button>
											<button type="button" data-accent="#06b6d4" class="accent-btn w-5 h-5 rounded-full bg-cyan-500 hover:scale-125 transition cursor-pointer" title="Cyan"></button>
											<button type="button" data-accent="#c2410c" class="accent-btn w-5 h-5 rounded-full bg-orange-600 hover:scale-125 transition cursor-pointer" title="Coral"></button>
											<button type="button" data-accent="#f43f5e" class="accent-btn w-5 h-5 rounded-full bg-rose-500 hover:scale-125 transition cursor-pointer" title="Rose"></button>
											<button type="button" data-accent="#10b981" class="accent-btn w-5 h-5 rounded-full bg-emerald-500 hover:scale-125 transition cursor-pointer" title="Emerald"></button>
											<button type="button" data-accent="#f59e0b" class="accent-btn w-5 h-5 rounded-full bg-amber-500 hover:scale-125 transition cursor-pointer" title="Amber"></button>
											<button type="button" data-accent="#8b5cf6" class="accent-btn w-5 h-5 rounded-full bg-purple-500 hover:scale-125 transition cursor-pointer" title="Purple"></button>
										</div>
									</div>
								</div>
							</div>

							<a href="https://github.com" target="_blank" rel="noopener" class="hover:text-[var(--text-main)] text-base" title="GitHub">
								<svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
							</a>
						</div>
					</div>
				</header>

				<!-- Center Content -->
				<div class="flex-1 max-w-[1240px] w-full mx-auto px-8 py-10 grid grid-cols-1 xl:grid-cols-12 gap-10">
					<main class="xl:col-span-9 space-y-12">
						<div class="border-b border-[var(--border-main)] pb-6">
							<div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-[var(--bg-hover)] text-xs font-semibold text-accent">
								<span>🧭 Essential First Steps</span>
							</div>
							<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-main)] mb-3">
								Beginners Guide
							</h1>
							<p class="text-[var(--text-muted)] text-[15.5px] leading-relaxed max-w-2xl">
								A simple, practical guide on how to safely navigate the web, spot deceptive download buttons, protect your privacy, and get the most out of EveryTool.
							</p>
						</div>

						<section id="adblocking" class="scroll-mt-24 space-y-4">
							<h2 class="text-2xl font-bold text-[var(--text-main)] flex items-center gap-2.5 pb-2 border-b border-[var(--border-main)]">
								<span>🛡️</span>
								<span>Adblocking & Popups</span>
							</h2>
							
							<div class="p-4.5 rounded-xl bg-[var(--tip-bg)] border border-[var(--tip-border)] text-sm space-y-1 shadow-sm">
								<div class="font-bold uppercase tracking-wider text-xs text-[var(--tip-text)]">💡 Golden Rule</div>
								<p class="text-[var(--text-main)] leading-relaxed text-[14.5px]">
									Never browse the free web without an adblocker. Deceptive ads often disguise themselves as fake "Download" buttons or spam you with malicious redirect popups.
								</p>
							</div>

							<div class="text-[15px] leading-relaxed text-[var(--text-main)] space-y-3">
								<p>
									For desktop browsers, we strongly recommend <a href="https://github.com/gorhill/uBlock" target="_blank" rel="noopener" class="font-bold text-accent hover:underline">uBlock Origin (uBO)</a>. It is completely open-source, uses minimal RAM, and blocks deceptive tracking scripts before they can load.
								</p>
								<ul class="list-disc list-inside space-y-2 pl-2">
									<li><strong>Desktop:</strong> Install <a href="https://ublockorigin.com/" target="_blank" rel="noopener" class="text-accent font-semibold hover:underline">uBlock Origin</a> on Firefox, Brave, or Chrome.</li>
									<li><strong>Mobile (Android):</strong> Use Firefox with uBlock Origin extension or Brave browser.</li>
									<li><strong>Mobile (iOS):</strong> Use Brave browser or Safari with AdGuard / wBlock.</li>
								</ul>
							</div>
						</section>

						<section id="antivirus" class="scroll-mt-24 space-y-4">
							<h2 class="text-2xl font-bold text-[var(--text-main)] flex items-center gap-2.5 pb-2 border-b border-[var(--border-main)]">
								<span>🦠</span>
								<span>Antivirus & Avoiding Fake Buttons</span>
							</h2>

							<div class="text-[15px] leading-relaxed text-[var(--text-main)] space-y-3">
								<p>How can you safely determine if a download is safe?</p>
								<ul class="list-disc list-inside space-y-2.5 pl-2">
									<li><strong>Spotting Fake Buttons:</strong> Real download links are usually simple, subtle text buttons. Huge, flashing green or red "START DOWNLOAD" buttons are almost always third-party advertisements!</li>
									<li><strong>Scan before opening:</strong> Always upload suspicious files or links to <a href="https://www.virustotal.com/" target="_blank" rel="noopener" class="font-bold text-accent hover:underline">VirusTotal</a>. It checks the file against 70+ antivirus engines in seconds.</li>
									<li><strong>Built-in Protection:</strong> On Windows 10/11, Windows Defender provides excellent baseline protection when paired with a good adblocker.</li>
								</ul>
							</div>
						</section>

						<section id="browsers" class="scroll-mt-24 space-y-4">
							<h2 class="text-2xl font-bold text-[var(--text-main)] flex items-center gap-2.5 pb-2 border-b border-[var(--border-main)]">
								<span>🌐</span>
								<span>Recommended Web Browsers</span>
							</h2>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="p-4 rounded-xl bg-[var(--bg-hover)] border border-[var(--border-main)]">
									<div class="font-bold text-[var(--text-main)] text-base mb-1">🦊 Mozilla Firefox</div>
									<p class="text-xs text-[var(--text-muted)] leading-relaxed mb-2">The premier choice for privacy and powerful adblocking. Supports full Manifest V2 extensions like uBlock Origin without limitations.</p>
									<a href="https://www.mozilla.org/firefox/" target="_blank" rel="noopener" class="text-xs font-semibold text-accent hover:underline">Download Firefox &rarr;</a>
								</div>

								<div class="p-4 rounded-xl bg-[var(--bg-hover)] border border-[var(--border-main)]">
									<div class="font-bold text-[var(--text-main)] text-base mb-1">🦁 Brave Browser</div>
									<p class="text-xs text-[var(--text-muted)] leading-relaxed mb-2">Chromium-based browser with aggressive built-in tracker and adblocking shields right out of the box. Fast and zero-setup.</p>
									<a href="https://brave.com/" target="_blank" rel="noopener" class="text-xs font-semibold text-accent hover:underline">Download Brave &rarr;</a>
								</div>
							</div>
						</section>

						<section id="archives" class="scroll-mt-24 space-y-4">
							<h2 class="text-2xl font-bold text-[var(--text-main)] flex items-center gap-2.5 pb-2 border-b border-[var(--border-main)]">
								<span>🗜️</span>
								<span>Safe File Extraction</span>
							</h2>

							<p class="text-[15px] leading-relaxed text-[var(--text-main)]">When downloading compressed archives (`.zip`, `.7z`, `.rar`, `.tar`), avoid adware-packed extractors like WinRAR trial popups. Use trusted, open-source extractors:</p>

							<ul class="list-disc list-inside space-y-2 pl-2 text-[15px] text-[var(--text-main)]">
								<li><a href="https://www.7-zip.org/" target="_blank" rel="noopener" class="font-bold text-accent hover:underline">7-Zip</a> — The lightweight gold standard for Windows. 100% free and open-source.</li>
								<li><a href="https://peazip.github.io/" target="_blank" rel="noopener" class="font-bold text-accent hover:underline">PeaZip</a> — Modern, beautiful cross-platform archive manager for Windows, Linux, and macOS.</li>
							</ul>
						</section>
					</main>

					<aside class="hidden xl:block xl:col-span-3 sticky top-20 h-[calc(100vh-5rem)]">
						<div class="font-bold text-[var(--text-main)] mb-3.5 text-sm">On this page</div>
						<ul class="space-y-2.5 text-[var(--text-muted)] border-l border-[var(--border-main)] pl-3.5 text-[13.5px]">
							<li><a href="#adblocking" class="hover:text-accent transition block py-0.5">Adblocking & Popups</a></li>
							<li><a href="#antivirus" class="hover:text-accent transition block py-0.5">Antivirus & File Safety</a></li>
							<li><a href="#browsers" class="hover:text-accent transition block py-0.5">Recommended Browsers</a></li>
							<li><a href="#archives" class="hover:text-accent transition block py-0.5">Safe File Extraction</a></li>
						</ul>
					</aside>
				</div>
			</div>
		</div>

		<script>
			const themeMenuBtn = document.getElementById("themeMenuBtn");
			const themeDropdown = document.getElementById("themeDropdown");
			const modeButtons = document.querySelectorAll(".theme-mode-option");
			const accentButtons = document.querySelectorAll(".accent-btn");

			themeMenuBtn?.addEventListener("click", (e) => {
				e.stopPropagation();
				themeDropdown.classList.toggle("hidden");
				updateActiveThemeIndicators();
			});

			document.addEventListener("click", (e) => {
				if (!themeDropdown.contains(e.target) && e.target !== themeMenuBtn) {
					themeDropdown.classList.add("hidden");
				}
			});

			function updateActiveThemeIndicators() {
				const currentMode = localStorage.getItem("everytool-mode") || "light";
				const currentAccent = localStorage.getItem("everytool-accent") || "#c2410c";

				modeButtons.forEach((btn) => {
					const mode = btn.getAttribute("data-mode");
					const check = btn.querySelector(".mode-check");
					if (mode === currentMode) {
						check.classList.remove("hidden");
					} else {
						check.classList.add("hidden");
					}
				});

				accentButtons.forEach((btn) => {
					const color = btn.getAttribute("data-accent");
					if (color === currentAccent) {
						btn.classList.add("ring-2", "ring-offset-2", "ring-accent");
					} else {
						btn.classList.remove("ring-2", "ring-offset-2", "ring-accent");
					}
				});
			}

			modeButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					const mode = btn.getAttribute("data-mode");
					document.documentElement.classList.remove("theme-dark", "theme-amoled");

					if (mode === "dark") {
						document.documentElement.classList.add("theme-dark");
					} else if (mode === "amoled") {
						document.documentElement.classList.add("theme-amoled");
					}

					localStorage.setItem("everytool-mode", mode);
					updateActiveThemeIndicators();
				});
			});

			accentButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					const color = btn.getAttribute("data-accent");
					document.documentElement.style.setProperty("--accent-color", color);
					localStorage.setItem("everytool-accent", color);
					updateActiveThemeIndicators();
				});
			});
		</script>
	</body>
</html>
